{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Webcmd",
  "description": "A browser for coding agents that learns how websites work as it uses them.",
  "colors": {
    "primary": "#006B9A",
    "light": "#56C5FF",
    "dark": "#006B9A"
  },
  "logo": {
    "light": "/webcmd-logo-light.svg",
    "dark": "/webcmd-logo-dark.svg",
    "href": "https://webcmd.dev"
  },
  "favicon": "/webcmd.svg",
  "appearance": {
    "default": "dark"
  },
  "background": {
    "color": {
      "light": "#F8F6F1",
      "dark": "#0F0F0F"
    }
  },
  "fonts": {
    "heading": {
      "family": "Newsreader",
      "weight": 700
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "groups": [
          {
            "group": "Start",
            "pages": [
              "index",
              "quickstart",
              "agent-prompts"
            ]
          },
          {
            "group": "Agent Harnesses",
            "pages": [
              "agents/aider",
              "agents/claude-code",
              "agents/cline",
              "agents/codex-cli",
              "agents/cursor",
              "agents/custom-sdk",
              "agents/hermes",
              "agents/openclaw",
              "agents/opencode",
              "agents/pi"
            ]
          },
          {
            "group": "Understand Webcmd",
            "pages": [
              "concepts",
              "authentication-and-profiles",
              "browser-and-sitemap-memory",
              "skills"
            ]
          },
          {
            "group": "Build and Share",
            "pages": [
              "browser-task-design"
            ]
          },
          {
            "group": "Use Cases",
            "pages": [
              "authenticated-browser-research"
            ]
          },
          {
            "group": "Reference and Support",
            "pages": [
              "cli-reference",
              "troubleshooting"
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/agent-runtime",
      "destination": "/concepts"
    },
    {
      "source": "/generated-clis",
      "destination": "/browser-task-design"
    },
    {
      "source": "/plugins-and-skills",
      "destination": "/skills"
    },
    {
      "source": "/authoring",
      "destination": "/browser-task-design"
    },
    {
      "source": "/create-plugin",
      "destination": "/browser-task-design"
    },
    {
      "source": "/publish-community-plugin",
      "destination": "/browser-task-design"
    },
    {
      "source": "/x-session-cli",
      "destination": "/authenticated-browser-research"
    }
  ]
}
